---
const { lineage } = Astro.props;
---
<p class="lineage-detail">{lineage.continuity_note}
  <a class="srcchip srcchip-link" href={lineage.source_url} target="_blank" rel="noopener noreferrer"><span aria-hidden="true"></span>{lineage.source_label} ↗</a>
</p>
<style>
  .lineage-detail { font-size:15px; line-height:1.85; color:#33312a; margin:0 0 15px; }
  a { display:inline-flex; align-items:center; gap:5px; color:#75726b; border:1px solid #e3e1da; border-radius:7px; padding:2px 8px; margin-left:7px; font-size:11.5px; text-decoration:none; white-space:nowrap; vertical-align:middle; position:relative; top:-1px; }
  a span { width:5px; height:5px; border-radius:1.5px; background:#2f5fe6; flex-shrink:0; }
  a:hover { color:#2f5fe6; }
  a:focus-visible { outline:2px solid #2f5fe6; outline-offset:4px; border-radius:2px; }
</style>
