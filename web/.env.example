# PostHog (opcional). Sin estas dos variables el sitio no carga PostHog.
# En producción van como variables de build en Cloudflare Workers Builds
# (se incrustan en el HTML al compilar, por eso llevan el prefijo PUBLIC_).
PUBLIC_POSTHOG_PROJECT_TOKEN=
# https://us.i.posthog.com (US Cloud) o https://eu.i.posthog.com (EU Cloud)
PUBLIC_POSTHOG_HOST=
