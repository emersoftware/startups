{
  // Static-asset deploy for the Astro build (web/dist).
  // Used by Cloudflare Workers Builds: `bunx astro build` then `npx wrangler deploy`.
  "name": "startups",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    // Las páginas /cardda están prerenderizadas (una por startup), así que las rutas
    // válidas existen como asset; las desconocidas devuelven el 404.html real.
    "not_found_handling": "404-page"
  }
}
