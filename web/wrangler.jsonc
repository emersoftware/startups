{
  // Static-asset deploy for the Astro build (web/dist).
  // Used by Cloudflare Workers Builds: `bunx astro build` then `npx wrangler deploy`.
  "name": "startups",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    // Sirve index.html en rutas como /cardda (deep-links de startups) en vez de 404.
    "not_found_handling": "single-page-application"
  }
}
